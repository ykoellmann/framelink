# Framelink frame config — copy to /etc/framelink/config.yaml

registry:
  url: "https://<your-registry-host>"
  api_key: "changeme"

overlay:
  enabled: true
  fields:
    album_name: true
    owner: true
    date: true
    location: true
  position: bottom
  opacity: 0.6

transition:
  style: fade        # fade | cut
  duration_ms: 1000

rotation:
  interval_minutes: 30
  order: random      # random | chronological | album_grouped

layout:
  portrait_pairing: true
  portrait_pair_preference: same_album_same_day  # same_album_same_day | same_album | any
  fill_mode: blurred  # blurred | black

schedule:
  active_periods:
    - start: "08:00"
      end: "22:00"

filters:
  date_range:
    mode: all          # all | recent | seasonal
    recent_years: null
    seasonal:
      enabled: false
      weight: 0.7       # how much out-of-season photos are down-weighted (0-1)
      window_months: 2  # half-window around today's day-of-year (in months)
      transition_days: 5  # soft transition zone at window edges
  excluded_photos: []   # individual photo GUIDs to never show
  excluded_albums: []   # album tokens to disable entirely

sync:
  auto: true
  interval_minutes: null  # null = auto-calculated (120 min)
  cache_dir: /var/lib/framelink/cache

geocoding:
  enabled: true
  user_agent: "framelink/0.1"

calendar:
  enabled: false        # true = calendar sidebar next to the photo (25 % of the screen)
  ids: []               # registry calendar ids to show on this frame; choose them in the web UI
  timezone: Europe/Berlin   # keep equal to the registry's FRAMELINK_TIMEZONE
  style: dark           # dark | glass | light
  horizon_weeks: 4      # 2-4; fewer weeks are shown automatically if they do not fit
  multi_line: true      # up to 2 lines per day instead of 1 line + "+n"
  edge: softer          # photo edge toward free space: hard | soft | softer | mirror
