[Unit]
Description=Framelink display service (pygame framebuffer)
After=local-fs.target
# Restart if it crashes — display should always be running
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=framelink
# Framebuffer access requires the 'video' group
SupplementaryGroups=video
EnvironmentFile=-/etc/framelink/env
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_FBDEV=/dev/fb0
ExecStart=/opt/framelink/venv/bin/framelink-display
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=framelink-display

[Install]
WantedBy=multi-user.target
