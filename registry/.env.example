# Copy to .env and fill in values

# Shared secret for the X-API-Key header (generate with: openssl rand -hex 32)
FRAMELINK_API_KEY=changeme

# Database backend — uncomment the one you want:

# Option A: SQLite (default, zero extra setup)
# FRAMELINK_DATABASE_URL=sqlite:///./data/framelink.db

# Option B: Existing PostgreSQL instance on the Pi
# FRAMELINK_DATABASE_URL=postgresql://framelink:secret@localhost:5432/framelink

# How often album metadata is refreshed from iCloud (minutes, default 60)
# FRAMELINK_METADATA_REFRESH_INTERVAL_MINUTES=60
