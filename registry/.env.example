# Copy to .env and fill in values

# Shared secret for the X-API-Key header (generate with: openssl rand -hex 32)
FRAMELINK_API_KEY=changeme

# Image tag of ghcr.io/ykoellmann/framelink-registry (latest, 1.2.3, 1.2, sha-...). Pin it for reproducible updates.
# (Ignored when building locally with docker-compose.build.yml.)
# FRAMELINK_REGISTRY_TAG=latest

# Database backend — uncomment the one you want:

# Option A: SQLite (default, zero extra setup)
# FRAMELINK_DATABASE_URL=sqlite:///./data/framelink.db

# Option B: Existing PostgreSQL instance on the Pi
# FRAMELINK_DATABASE_URL=postgresql://framelink:secret@localhost:5432/framelink

# How often album metadata is refreshed from iCloud (minutes, default 60)
# FRAMELINK_METADATA_REFRESH_INTERVAL_MINUTES=60

# Calendar sidebar: timezone for timed events and "today" (must match the frames)
# FRAMELINK_TIMEZONE=Europe/Berlin
# How often calendar (ICS) sources are re-fetched (minutes, default 30)
# FRAMELINK_CALENDAR_REFRESH_INTERVAL_MINUTES=30
# Stored window around today, in days (defaults 14 back / 90 ahead)
# FRAMELINK_CALENDAR_WINDOW_BACK_DAYS=14
# FRAMELINK_CALENDAR_WINDOW_AHEAD_DAYS=90
